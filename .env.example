# Resend API Key aus https://resend.com/api-keys
# NICHT hier eintragen — echten Key nur in .env.local und in Vercel setzen!
RESEND_API_KEY=dein_key_hier

# Deine eigene E-Mail-Adresse, an die die Antwort geschickt wird.
# Wichtig: Bei Nutzung des Standard-Absenders onboarding@resend.dev
# muss dies die E-Mail sein, mit der du dein Resend-Konto angelegt hast.
RECIPIENT_EMAIL=juliusdeusch@gmail.com
